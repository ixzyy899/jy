<!-- SKILLS -->
<section id="skills">
    <div class="reveal">
        <div class="section-label">02 / KEAHLIAN</div>
        <h2 class="section-title">Creative abilities.</h2>
        <p class="section-desc">
            Beberapa bidang yang saya minati dan terus kembangkan
