
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IXZY | Julian Ikhsan Portfolio</title>

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
    --bg: #080808;
    --card: #141414;
    --purple: #7560c9;
    --white: #f5f5f5;
    --gray: #999;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: var(--bg);
    color: var(--white);
    font-family: 'Poppins', sans-serif;
    overflow-x: hidden;
}

a {
    color: inherit;
    text-decoration: none;
}

/* NAVBAR */

header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 20px 8%;
    background: rgba(8,8,8,.85);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid #ffffff12;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-family: 'Orbitron', sans-serif;
    font-size: 28px;
    font-weight: 900;
    color: var(--purple);
    letter-spacing: 3px;
}

.nav-links {
    display: flex;
    gap: 35px;
    list-style: none;
}

.nav-links a {
    font-size: 13px;
    color: #ccc;
    transition: .3s;
}

.nav-links a:hover {
    color: var(--purple);
}

.menu-toggle {
    display: none;
    font-size: 25px;
    cursor: pointer;
}

/* HERO */

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 130px 10% 80px;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: "";
    position: absolute;
    width: 450px;
    height: 450px;
    background: var(--purple);
    filter: blur(180px);
    opacity: .18;
    right: -100px;
    top: 100px;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 750px;
}

.small-title {
    color: var(--purple);
    letter-spacing: 5px;
    font-size: 12px;
    margin-bottom: 25px;
}

.hero h1 {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(45px, 8vw, 95px);
    line-height: 1.1;
    font-weight: 900;
    margin-bottom: 20px;
}

.hero h1 span {
    color: var(--purple);
}

.hero p {
    color: #aaa;
    font-size: 15px;
    line-height: 1.9;
    max-width: 550px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 35px;
    flex-wrap: wrap;
}

.btn {
    padding: 13px 25px;
    border: 1px solid var(--purple);
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    transition: .3s;
}

.btn-primary {
    background: var(--purple);
    color: white;
}

.btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px #7560c944;
}

/* GENERAL SECTION */

section {
    padding: 100px 10%;
}

.section-label {
    color: var(--purple);
    letter-spacing: 5px;
    font-size: 11px;
    margin-bottom: 15px;
}

.section-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(28px, 5vw, 45px);
    margin-bottom: 25px;
}

.section-desc {
    color: var(--gray);
    line-height: 1.9;
    font-size: 14px;
    max-width: 650px;
}

/* ABOUT */

.about {
    background: #0d0d0d;
}

.about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.about-box {
    border-left: 3px solid var(--purple);
    padding: 25px;
    background: var(--card);
}

.about-box h3 {
    font-family: 'Orbitron', sans-serif;
    margin-bottom: 15px;
}

.about-box p {
    color: #aaa;
    font-size: 13px;
    line-height: 1.9;
}

/* SKILLS */

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
}

.skill-card {
    background: var(--card);
    border: 1px solid #ffffff10;
    padding: 30px;
    transition: .3s;
}

.skill-card:hover {
    border-color: var(--purple);
    transform: translateY(-7px);
}

.skill-card h3 {
    font-size: 16px;
    margin-bottom: 10px;
}

.skill-card p {
    color: var(--gray);
    font-size: 12px;
    line-height: 1.8;
}

/* PROJECTS */

.projects {
    background: #0d0d0d;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 45px;
}

.project-card {
    background: #151515;
    border: 1px solid #ffffff12;
    overflow: hidden;
    transition: .4s;
}

.project-card:hover {
    transform: translateY(-8px);
    border-color: var(--purple);
}

.project-image {
    width: 100%;
    height: 390px;
    overflow: hidden;
    background: #202020;
}

.project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .5s;
}

.project-card:hover img {
    transform: scale(1.05);
}

.project-info {
    padding: 25px;
}

.project-number {
    color: var(--purple);
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    letter-spacing: 3px;
}

.project-info h3 {
    font-size: 22px;
    margin: 10px 0;
}

.project-info p {
    color: var(--gray);
    font-size: 12px;
    line-height: 1.8;
}

/* FOOTER */

footer {
    padding: 40px 10%;
    text-align: center;
    background: #050505;
    border-top: 1px solid #ffffff12;
}

.footer-logo {
    font-family: 'Orbitron', sans-serif;
    font-size: 30px;
    font-weight: 900;
    color: var(--purple);
    letter-spacing: 5px;
}

footer p {
    margin-top: 15px;
    font-size: 11px;
    color: #777;
}

/* ANIMATION */

.reveal {
    opacity: 0;
    transform: translateY(35px);
    transition: .8s ease;
}

.reveal.active {
    opacity: 1;
    transform: translateY(0);
}

/* RESPONSIVE */

@media(max-width: 768px) {

    header {
        padding: 18px 6%;
    }

    .menu-toggle {
        display: block;
    }

    .nav-links {
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        background: #101010;
        display: none;
        flex-direction: column;
        padding: 25px 7%;
        gap: 25px;
        border-bottom: 1px solid #ffffff15;
    }

    .nav-links.show {
        display: flex;
    }

    .hero {
        padding: 140px 7% 80px;
        min-height: 90vh;
    }

    section {
        padding: 75px 7%;
    }

    .about-content {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .skills-grid {
        grid-template-columns: 1fr;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .project-image {
        height: 350px;
    }
}

@media(max-width: 400px) {
    .project-image {
        height: 280px;
    }

    .hero h1 {
        font-size: 43px;
    }
}
</style>
</head>

<body>

<!-- NAVBAR -->
<header>
    <nav class="navbar">
        <a href="#home" class="logo">IXZY.</a>

        <div class="menu-toggle" id="menuToggle">☰</div>

        <ul class="nav-links" id="navLinks">
            <li><a href="#home">Beranda</a></li>
            <li><a href="#about">Tentang Saya</a></li>
            <li><a href="#skills">Keahlian</a></li>
            <li><a href="#projects">Galeri Karya</a></li>
        </ul>
    </nav>
</header>

<!-- HERO -->
<section class="hero" id="home">
    <div class="hero-content reveal">
        <div class="small-title">PORTOFOLIO PRIBADI</div>

        <h1>
            CREATIVE<br>
            <span>MINDSET.</span>
        </h1>

        <p>
            Halo, saya <b>Julian Ikhsan</b>, seorang desainer grafis
